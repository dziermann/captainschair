---
import '../styles/global.css';
import { Navigation } from '../components/Navigation';
import { DarkModeToggle } from '../components/DarkModeToggle';

interface Props {
	title: string;
}

const { title } = Astro.props;
const { lang = 'en' } = Astro.params;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Captain's Chair Card Filter" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/captainschair/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#F8991D" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="Captain's Chair" />
		<link rel="apple-touch-icon" href="/captainschair/favicon.svg" />
		<title>{title}</title>
		<script is:inline>
			// Register Service Worker
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/captainschair/sw.js');
				});
			}
		</script>
        <script is:inline>
            (function() {
                const theme = (() => {
                    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                        return localStorage.getItem('theme');
                    }
                    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                        return 'dark';
                    }
                    return 'light';
                })();

                if (theme === 'dark') {
                    document.documentElement.classList.add('dark');
                } else {
                    document.documentElement.classList.remove('dark');
                }
            })();
        </script>
	</head>
	<body class="bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 font-sans min-h-screen flex flex-col select-none touch-manipulation overflow-hidden">
        <main class="flex-1 overflow-y-auto safe-top safe-bottom">
            <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
                <slot />
            </div>
            <footer class="p-8 bg-white dark:bg-zinc-900 border-t border-zinc-200 dark:border-zinc-800 text-center text-zinc-500 text-sm">
                <div class="mx-auto max-w-7xl px-4 flex flex-col gap-2">
                    <p>&copy; {new Date().getFullYear()} Captain's Chair Card Database. All rights reserved.</p>
                    <p class="mt-2 text-xs opacity-75">
                        This project is a fan-made database and is not affiliated with, endorsed by, or sponsored by ViacomCBS, WizKids, or the creators of the Star Trek Captain's Chair board game.
                    </p>
                    <p class="text-xs opacity-75 italic">
                        Star Trek and all related marks, logos and characters are trademarks of CBS Studios Inc. All rights reserved. WizKids and its associated logos are trademarks of WizKids.
                    </p>
                </div>
            </footer>
        </main>
	</body>
</html>
